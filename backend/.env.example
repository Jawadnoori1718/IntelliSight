# ─────────────────────────────────────────────
#  IntelliSight backend — environment settings
#  Copy this file to ".env" and edit if you need to.
#  (Everything has sensible defaults, so .env is optional.)
# ─────────────────────────────────────────────

APP_NAME=IntelliSight
ENVIRONMENT=development

# Where the backend listens
HOST=127.0.0.1
PORT=8000

# Which frontend origins may call the API (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Added later ──
# Phase 10 (AI brain) — your Claude API key:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
