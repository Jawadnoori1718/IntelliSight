# ─────────────────────────────────────────────
#  IntelliSight Desktop — environment settings
#  Copy this file to ".env" (in the same folder) and add your key.
#  The ".env" file is git-ignored, so your key stays private.
# ─────────────────────────────────────────────

# Your Claude API key — enables scene understanding, chat, and other AI features.
# Get one at https://console.anthropic.com/  (Settings → API Keys).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional ──
# Which Claude model describes the scene. Default is the most capable (Opus 4.8).
# For a cheaper/faster option, use: claude-haiku-4-5
# INTELLISIGHT_SCENE_MODEL=claude-opus-4-8

# How often (seconds) to re-describe the scene. Higher = fewer API calls = lower cost.
# INTELLISIGHT_SCENE_INTERVAL=15
